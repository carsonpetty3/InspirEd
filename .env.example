# Caregiver app (Expo). Copy to .env and fill in. Do not commit .env.
# The asset library uses asset-admin/.env instead.

GEMINI_API_KEY=

# Leave empty to use the bundled knowledge base.
# Set this to the asset-admin LAN URL when that server is running, for example http://192.168.1.20:3000
EXPO_PUBLIC_RAG_API_URL=

# Base URL for Learn and video-library asset requests. Usually the same host as EXPO_PUBLIC_RAG_API_URL.
EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_PROTOTYPE_RAG_MODE=true

# Optional video library
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_VIDEO_FOLDER_ID=
