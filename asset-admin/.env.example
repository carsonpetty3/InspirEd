# Copy to .env — do not commit .env. See ../docs/deployment.md
# The same variables go in Vercel → Project → Settings → Environment Variables.

# Required: every AI feature in the app (transcription, chat, lessons) runs here now
GEMINI_API_KEY=

# MongoDB content database. Optional locally: without it, AI answers use assets/medical-knowledge.json
MONGO_URI=your_mongodb_connection_string_here
PORT=3000

# Password for the content admin (/admin). Leave empty locally for open LAN access;
# required on Vercel, where admin is disabled without it.
ADMIN_PASSWORD=

# Set to true to answer only from assets marked clinically reviewed (skips the legacy
# medical-knowledge.json fallback). Off by default while content is still being reviewed.
REQUIRE_CLINICAL_REVIEW=false

# Optional: store uploads in Vercel Blob instead of asset-admin/uploads (set automatically on Vercel)
BLOB_READ_WRITE_TOKEN=

# Optional: Google Drive video library
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_VIDEO_FOLDER_ID=

# Optional: extra origins allowed to call the API cross-origin (comma-separated).
# Not needed for the Vercel web app (same origin) or Expo Go (no Origin header).
ALLOWED_ORIGINS=
